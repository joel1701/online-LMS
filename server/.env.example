# Copy this file to .env (same folder) and adjust if needed.

PORT=5050
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/campuscore
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuscore
# Leave it empty to run on in-memory sample data instead (changes are lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/campuscore

# Optional: add a delay (ms) to every API response to show loading states.
# MOCK_LATENCY_MS=600

# Not used yet. Needed once tokens are replaced with JWTs.
# JWT_SECRET=change-me
# JWT_EXPIRES_IN=1d
